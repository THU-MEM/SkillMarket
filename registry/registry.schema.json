{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thu-mem.github.io/SkillMarket/registry.schema.json",
  "title": "SkillMarket registry entry",
  "oneOf": [
    { "$ref": "#/$defs/skill" },
    { "$ref": "#/$defs/agent" },
    { "$ref": "#/$defs/prompt" }
  ],
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions"],
      "properties": {
        "instructions": { "type": "string", "minLength": 20, "maxLength": 2000 },
        "example": { "type": "string", "minLength": 5, "maxLength": 4000 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryFile", "sourceUrl"],
      "properties": {
        "primaryFile": { "type": "string", "minLength": 3, "maxLength": 300 },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "rawUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "details"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "details": { "type": "string", "minLength": 5, "maxLength": 300 },
        "check": { "type": "string", "minLength": 2, "maxLength": 300 }
      }
    },
    "installStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "minLength": 5, "maxLength": 500 },
        "command": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "expected": { "type": "string", "minLength": 2, "maxLength": 500 }
      }
    },
    "lifecycleAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 5, "maxLength": 500 },
        "command": { "type": "string", "minLength": 2, "maxLength": 1000 }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "summary",
        "client",
        "scope",
        "platforms",
        "officialStatus",
        "steps",
        "evidenceUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 64
        },
        "type": { "enum": ["cli", "manual", "deeplink", "download"] },
        "label": { "type": "string", "minLength": 3, "maxLength": 100 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 500 },
        "client": {
          "enum": ["github-copilot", "github-copilot-cli", "claude-code", "codex", "cursor", "opencode", "hermes", "universal"]
        },
        "scope": { "enum": ["project", "user", "interactive"] },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["windows", "macos", "linux", "web"] }
        },
        "officialStatus": { "enum": ["official", "maintainer", "community"] },
        "recommended": { "type": "boolean" },
        "command": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "targetPath": { "type": "string", "minLength": 3, "maxLength": 500 },
        "prerequisites": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/prerequisite" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/installStep" }
        },
        "verify": { "$ref": "#/$defs/lifecycleAction" },
        "update": { "$ref": "#/$defs/lifecycleAction" },
        "uninstall": { "$ref": "#/$defs/lifecycleAction" },
        "securityNote": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "evidenceUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "cli" } } },
          "then": { "required": ["command"] }
        },
        {
          "if": { "properties": { "type": { "const": "manual" } } },
          "then": { "required": ["targetPath"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["deeplink", "download"] } } },
          "then": { "required": ["url"] }
        }
      ]
    },
    "base": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "description",
        "author",
        "source",
        "tags",
        "version",
        "license",
        "updatedAt",
        "isExample",
        "usage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 64
        },
        "type": { "enum": ["skill", "agent", "prompt"] },
        "name": { "type": "string", "minLength": 3, "maxLength": 80 },
        "description": { "type": "string", "minLength": 10, "maxLength": 160 },
        "author": { "$ref": "#/$defs/author" },
        "source": { "$ref": "#/$defs/source" },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 30
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "license": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-.+]+$",
          "maxLength": 40
        },
        "updatedAt": { "type": "string", "format": "date" },
        "isExample": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "usage": { "$ref": "#/$defs/usage" }
      },
      "anyOf": [{ "required": ["repository"] }, { "required": ["url"] }]
    },
    "skill": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["installations"],
          "properties": {
            "type": { "const": "skill" },
            "installations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": { "$ref": "#/$defs/installation" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "agent": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["setup"],
          "properties": {
            "type": { "const": "agent" },
            "setup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["instructions", "requirements"],
              "properties": {
                "instructions": { "type": "string", "minLength": 20, "maxLength": 2000 },
                "requirements": {
                  "type": "array",
                  "maxItems": 10,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 2, "maxLength": 100 }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "prompt": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["prompt"],
          "properties": {
            "type": { "const": "prompt" },
            "prompt": {
              "type": "object",
              "additionalProperties": false,
              "required": ["template", "variables"],
              "properties": {
                "template": { "type": "string", "minLength": 20, "maxLength": 8000 },
                "variables": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "description", "required"],
                    "properties": {
                      "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                      "description": { "type": "string", "minLength": 5, "maxLength": 200 },
                      "required": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
