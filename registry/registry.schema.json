{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thu-mem.github.io/SkillMarket/registry.schema.json",
  "title": "SkillMarket registry entry",
  "oneOf": [
    { "$ref": "#/$defs/skill" },
    { "$ref": "#/$defs/agent" },
    { "$ref": "#/$defs/prompt" }
  ],
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions"],
      "properties": {
        "instructions": { "type": "string", "minLength": 20, "maxLength": 2000 },
        "example": { "type": "string", "minLength": 5, "maxLength": 4000 }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "description",
        "author",
        "tags",
        "version",
        "license",
        "updatedAt",
        "isExample",
        "usage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 64
        },
        "type": { "enum": ["skill", "agent", "prompt"] },
        "name": { "type": "string", "minLength": 3, "maxLength": 80 },
        "description": { "type": "string", "minLength": 40, "maxLength": 500 },
        "author": { "$ref": "#/$defs/author" },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 30
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "license": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-.+]+$",
          "maxLength": 40
        },
        "updatedAt": { "type": "string", "format": "date" },
        "isExample": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "usage": { "$ref": "#/$defs/usage" }
      },
      "anyOf": [{ "required": ["repository"] }, { "required": ["url"] }]
    },
    "skill": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["installation"],
          "properties": {
            "type": { "const": "skill" },
            "installation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command"],
              "properties": {
                "command": { "type": "string", "minLength": 3, "maxLength": 500 },
                "notes": { "type": "string", "maxLength": 1000 }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "agent": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["setup"],
          "properties": {
            "type": { "const": "agent" },
            "setup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["instructions", "requirements"],
              "properties": {
                "instructions": { "type": "string", "minLength": 20, "maxLength": 2000 },
                "requirements": {
                  "type": "array",
                  "maxItems": 10,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 2, "maxLength": 100 }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "prompt": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["prompt"],
          "properties": {
            "type": { "const": "prompt" },
            "prompt": {
              "type": "object",
              "additionalProperties": false,
              "required": ["template", "variables"],
              "properties": {
                "template": { "type": "string", "minLength": 20, "maxLength": 8000 },
                "variables": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "description", "required"],
                    "properties": {
                      "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                      "description": { "type": "string", "minLength": 5, "maxLength": 200 },
                      "required": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
