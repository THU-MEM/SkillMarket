{
  "name": "skillmarket",
  "private": true,
  "version": "0.1.0",
  "description": "An open, file-based marketplace for Skills, Agents, and Prompts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/THU-MEM/SkillMarket.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "validate:registry": "node scripts/validate-registry.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate:registry && npm run test && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@heroui/react": "2.8.5",
    "@heroui/theme": "2.4.23",
    "fflate": "0.8.3",
    "framer-motion": "12.23.24",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.2"
  }
}
